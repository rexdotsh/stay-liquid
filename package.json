{
  "name": "stay-liquid",
  "version": "0.2.0",
  "description": "Native iOS Liquid Glass tab bars for Capacitor applications.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src/",
    "ios/Sources",
    "Package.swift",
    "StayLiquid.podspec",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "sideEffects": false,
  "author": "Alistair Heath",
  "contributors": [
    "rexdotsh"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rexdotsh/stay-liquid.git"
  },
  "bugs": {
    "url": "https://github.com/rexdotsh/stay-liquid/issues"
  },
  "homepage": "https://github.com/rexdotsh/stay-liquid#readme",
  "keywords": [
    "capacitor",
    "ios",
    "ionic",
    "liquid-glass",
    "tab-bar"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    }
  },
  "scripts": {
    "check": "node --check src/index.js",
    "verify:ios": "xcodebuild -scheme StayLiquid -destination generic/platform=iOS",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0 <9.0.0"
  }
}
